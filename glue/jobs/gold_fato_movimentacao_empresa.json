{
  "Name": "gold_fato_movimentacao_empresa",
  "Description": "fato_movimentacao_empresa: eventos do CDF da consolidada no --ano_mes",
  "Role": "arn:aws:iam::724793286570:role/glue-pipeline",
  "GlueVersion": "5.0",
  "WorkerType": "G.1X",
  "NumberOfWorkers": 2,
  "ExecutionClass": "FLEX",
  "MaxRetries": 1,
  "Timeout": 30,
  "Command": {
    "Name": "glueetl",
    "ScriptLocation": "s3://goodlion-artifacts-724793286570/scripts/gold_fato_movimentacao_empresa.py",
    "PythonVersion": "3"
  },
  "DefaultArguments": {
    "--conf": "spark.sql.extensions=io.delta.sql.DeltaSparkSessionExtension --conf spark.sql.catalog.spark_catalog=org.apache.spark.sql.delta.catalog.DeltaCatalog",
    "--ambiente": "sample",
    "--job-bookmark-option": "job-bookmark-disable",
    "--job-language": "python",
    "--datalake-formats": "delta",
    "--TempDir": "s3://goodlion-artifacts-724793286570/temporary/",
    "--bucket": "goodlion-gold-724793286570",
    "--enable-continuous-cloudwatch-log": "true",
    "--bucket_silver": "goodlion-silver-724793286570"
  },
  "CodeGenConfigurationNodes": {
    "node-consolidada": {
      "S3DeltaSource": {
        "Name": "silver_empresa_consolidada",
        "Paths": [
          "s3://goodlion-silver-724793286570/sample/empresa_consolidada/"
        ]
      }
    },
    "node-mudancas": {
      "CustomCode": {
        "Name": "ler_mudancas",
        "Inputs": [
          "node-consolidada"
        ],
        "Code": "@arquivo:jobs/custom/ler_mudancas.py",
        "ClassName": "LerMudancas"
      }
    },
    "node-selecionar": {
      "SelectFromCollection": {
        "Name": "selecionar",
        "Inputs": [
          "node-mudancas"
        ],
        "Index": 0
      }
    },
    "node-sql": {
      "SparkSQL": {
        "Name": "gold_fato_movimentacao_empresa",
        "Inputs": [
          "node-selecionar"
        ],
        "SqlQuery": "@arquivo:jobs/sql/gold/fato_movimentacao_empresa.sql",
        "SqlAliases": [
          {
            "From": "node-selecionar",
            "Alias": "mudancas"
          }
        ]
      }
    },
    "node-gravar": {
      "CustomCode": {
        "Name": "gravar_delta",
        "Inputs": [
          "node-sql"
        ],
        "Code": "@arquivo:jobs/custom/gravar_delta.py",
        "ClassName": "GravarDelta"
      }
    }
  }
}

{
  "Name": "silver_estabelecimentos",
  "Description": "bronze -> silver de Estabelecimentos, limitado por --ano_mes",
  "Role": "arn:aws:iam::724793286570:role/glue-pipeline",
  "GlueVersion": "5.0",
  "WorkerType": "G.1X",
  "NumberOfWorkers": 2,
  "ExecutionClass": "FLEX",
  "MaxRetries": 1,
  "Timeout": 30,
  "Command": {
    "Name": "glueetl",
    "ScriptLocation": "s3://goodlion-artifacts-724793286570/scripts/silver_estabelecimentos.py",
    "PythonVersion": "3"
  },
  "DefaultArguments": {
    "--conf": "spark.sql.extensions=io.delta.sql.DeltaSparkSessionExtension --conf spark.sql.catalog.spark_catalog=org.apache.spark.sql.delta.catalog.DeltaCatalog",
    "--ambiente": "sample",
    "--job-bookmark-option": "job-bookmark-disable",
    "--job-language": "python",
    "--datalake-formats": "delta",
    "--TempDir": "s3://goodlion-artifacts-724793286570/temporary/",
    "--bucket": "goodlion-silver-724793286570",
    "--enable-continuous-cloudwatch-log": "true"
  },
  "CodeGenConfigurationNodes": {
    "node-estabelecimentos": {
      "S3DeltaSource": {
        "Name": "bronze_estabelecimentos",
        "Paths": [
          "s3://goodlion-bronze-724793286570/sample/estabelecimentos/"
        ]
      }
    },
    "node-filtrar-estabelecimentos": {
      "CustomCode": {
        "Name": "filtrar_estabelecimentos",
        "Inputs": [
          "node-estabelecimentos"
        ],
        "Code": "@arquivo:jobs/custom/filtrar_mes.py",
        "ClassName": "FiltrarMesEstabelecimentos"
      }
    },
    "node-mes-estabelecimentos": {
      "SelectFromCollection": {
        "Name": "mes_estabelecimentos",
        "Inputs": [
          "node-filtrar-estabelecimentos"
        ],
        "Index": 0
      }
    },
    "node-sql": {
      "SparkSQL": {
        "Name": "limpar_estabelecimentos",
        "Inputs": [
          "node-mes-estabelecimentos"
        ],
        "SqlQuery": "@arquivo:jobs/sql/silver/estabelecimentos.sql",
        "SqlAliases": [
          {
            "From": "node-mes-estabelecimentos",
            "Alias": "bronze_estabelecimentos"
          }
        ]
      }
    },
    "node-gravar": {
      "CustomCode": {
        "Name": "gravar_delta",
        "Inputs": [
          "node-dq-alertas"
        ],
        "Code": "@arquivo:jobs/custom/gravar_delta.py",
        "ClassName": "GravarDelta"
      }
    },
    "node-dq": {
      "EvaluateDataQuality": {
        "Name": "qualidade_estabelecimentos",
        "Inputs": [
          "node-sql"
        ],
        "Ruleset": "@arquivo:jobs/quality/silver_estabelecimentos.dqdl",
        "Output": "PrimaryInput",
        "PublishingOptions": {
          "EvaluationContext": "silver_estabelecimentos",
          "ResultsS3Prefix": "s3://goodlion-artifacts-724793286570/dq/",
          "CloudWatchMetricsEnabled": false,
          "ResultsPublishingEnabled": true
        },
        "StopJobOnFailureOptions": {
          "StopJobOnFailureTiming": "Immediate"
        }
      }
    },
    "node-dq-alertas": {
      "EvaluateDataQuality": {
        "Name": "silver_estabelecimentos",
        "Inputs": [
          "node-dq"
        ],
        "Ruleset": "@arquivo:jobs/quality/silver_estabelecimentos_alertas.dqdl",
        "Output": "PrimaryInput",
        "PublishingOptions": {
          "EvaluationContext": "silver_estabelecimentos_alertas",
          "ResultsS3Prefix": "s3://goodlion-artifacts-724793286570/dq/",
          "CloudWatchMetricsEnabled": false,
          "ResultsPublishingEnabled": true
        }
      }
    }
  }
}

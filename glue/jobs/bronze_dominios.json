{
  "Name": "bronze_dominios",
  "Description": "raw (CSV) -> bronze (Delta) dos 6 domínios da Receita, com Job Bookmarks",
  "Role": "arn:aws:iam::724793286570:role/glue-pipeline",
  "GlueVersion": "5.0",
  "WorkerType": "G.1X",
  "NumberOfWorkers": 2,
  "ExecutionClass": "FLEX",
  "MaxRetries": 1,
  "Timeout": 30,
  "Command": {
    "Name": "glueetl",
    "ScriptLocation": "s3://goodlion-artifacts-724793286570/scripts/bronze_dominios.py",
    "PythonVersion": "3"
  },
  "DefaultArguments": {
    "--conf": "spark.sql.extensions=io.delta.sql.DeltaSparkSessionExtension --conf spark.sql.catalog.spark_catalog=org.apache.spark.sql.delta.catalog.DeltaCatalog",
    "--ambiente": "sample",
    "--job-bookmark-option": "job-bookmark-enable",
    "--job-language": "python",
    "--datalake-formats": "delta",
    "--TempDir": "s3://goodlion-artifacts-724793286570/temporary/",
    "--bucket": "goodlion-bronze-724793286570",
    "--enable-continuous-cloudwatch-log": "true"
  },
  "CodeGenConfigurationNodes": {
    "node-raw-cnaes": {
      "CatalogSource": {
        "Name": "raw_cnaes",
        "Database": "goodlion_raw",
        "Table": "cnaes",
        "PartitionPredicate": ""
      }
    },
    "node-esquema-cnaes": {
      "CustomCode": {
        "Name": "garantir_esquema_cnaes",
        "Inputs": [
          "node-raw-cnaes"
        ],
        "Code": "@arquivo:jobs/custom/garantir_esquema.py",
        "ClassName": "GarantirEsquemaCnaes"
      }
    },
    "node-selecionar-cnaes": {
      "SelectFromCollection": {
        "Name": "selecionar_cnaes",
        "Inputs": [
          "node-esquema-cnaes"
        ],
        "Index": 0
      }
    },
    "node-sql-cnaes": {
      "SparkSQL": {
        "Name": "bronze_cnaes",
        "Inputs": [
          "node-selecionar-cnaes"
        ],
        "SqlQuery": "@arquivo:jobs/sql/bronze/cnaes.sql",
        "SqlAliases": [
          {
            "From": "node-selecionar-cnaes",
            "Alias": "raw_cnaes"
          }
        ]
      }
    },
    "node-gravar-cnaes": {
      "CustomCode": {
        "Name": "gravar_cnaes",
        "Inputs": [
          "node-sql-cnaes"
        ],
        "Code": "@arquivo:jobs/custom/gravar_delta.py",
        "ClassName": "GravarDeltaCnaes"
      }
    },
    "node-raw-motivos": {

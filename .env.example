# Copie para .env e ajuste: cp .env.example .env
# O docker compose lê o .env sozinho; o Makefile passa para o Python via `uv run --env-file .env`.

# MinIO (S3 local)
MINIO_ROOT_USER=goodlion
MINIO_ROOT_PASSWORD=troque-esta-senha

# Postgres do dashboard
POSTGRES_USER=goodlion
POSTGRES_PASSWORD=troque-esta-senha

# Metabase (a porta 3000 costuma estar ocupada por outros projetos)
METABASE_PORT=3001

# Acesso do código (boto3/DuckDB) ao S3. Localmente aponta para o MinIO,
# com as mesmas credenciais do MINIO_ROOT_*. Na AWS, S3_ENDPOINT fica vazio
# e as credenciais vêm do perfil da AWS (não use estas variáveis lá).
S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=goodlion
AWS_SECRET_ACCESS_KEY=troque-esta-senha
AWS_REGION=us-east-1
